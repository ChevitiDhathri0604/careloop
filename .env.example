# .env.example for CareLoop Enterprise
# Copy this file to .env and configure for local development or production deployment.

# ==============================================================================
# 1. Server & Deployment Configuration
# ==============================================================================
HOST=0.0.0.0
PORT=8000
ENV=production

# Persistent storage paths (will be created automatically if missing)
DATABASE_PATH=data/careloop.db
UPLOAD_DIR=data/uploads

# Webhook notification endpoint for emergency safety alerts
WEBHOOK_URL=

# ==============================================================================
# 2. Multi-Model LLM Gateway Configuration
# Options: DETERMINISTIC (Zero-cost baseline), GEMINI, GROQ, OLLAMA, OPENAI
# ==============================================================================
LLM_PROVIDER=DETERMINISTIC

# Google Gemini API key (https://aistudio.google.com/)
GEMINI_API_KEY=

# Groq Cloud API key (https://console.groq.com/)
GROQ_API_KEY=

# OpenAI or compatible LLM proxy API key
OPENAI_API_KEY=

# Ollama Local Offline LLM Base URL
OLLAMA_BASE_URL=http://localhost:11434

# Configurable Model Tiers
SMALL_MODEL=gemini-1.5-flash
LARGE_MODEL=gemini-1.5-pro
