# .env example for CareLoop prototype
# Copy this file to .env and fill in your API keys as needed.

# LLM provider (options: GEMINI, GROQ, OLLAMA, DETERMINISTIC)
LLM_PROVIDER=DETERMINISTIC

# Gemini API key (if using GEMINI)
GEMINI_API_KEY=

# Groq API key (if using GROQ)
GROQ_API_KEY=

# OpenAI compatible API key (if using OLLAMA or OpenAI)
OPENAI_API_KEY=

# Base URL for Ollama (if using OLLAMA)
OLLAMA_BASE_URL=http://localhost:11434

# Model names (optional, defaults are set in code)
SMALL_MODEL=gemini-1.5-flash
LARGE_MODEL=gemini-1.5-pro
